<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="UserLoginIn.SearchPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="IndexTF">

    <!-- Современные стили -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Цветовая палитра -->
            <Color x:Key="PrimaryBg">#FFFFFF</Color>
            <Color x:Key="SecondaryBg">#F8F9FA</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="AccentPrimary">#6366F1</Color>
            <Color x:Key="AccentSecondary">#8B5CF6</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="TextTertiary">#9CA3AF</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
            <Color x:Key="HoverBg">#F3F4F6</Color>
            <Color x:Key="AccentGlow">#EEF2FF</Color>
            <Color x:Key="ShadowColor">#1A202C</Color>

            <!-- Градиент для заголовка -->
            <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#6366F1" Offset="0.0"/>
                <GradientStop Color="#8B5CF6" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Неоморфные тени для карточек -->
            <Shadow x:Key="CardShadow" 
                    Brush="{StaticResource ShadowColor}" 
                    Opacity="0.08" 
                    Radius="16" 
                    Offset="0,4"/>

            <Shadow x:Key="GlowEffect" 
                    Brush="{StaticResource AccentPrimary}" 
                    Opacity="0.15" 
                    Radius="12" 
                    Offset="0,2"/>

            <!-- Стиль кнопок -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="24,14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#40000000" Opacity="0.15" Radius="8" Offset="0,2"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стиль основных Border -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="16"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#30000000" Opacity="0.08" Radius="12" Offset="0,2"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стиль для профиля -->
            <Style x:Key="ProfileBadge" TargetType="Border">
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="20"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#30000000" Opacity="0.1" Radius="8" Offset="0,2"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Премиальная карточка результата -->
            <Style x:Key="ResultCardStyle" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                <Setter Property="Shadow" Value="{StaticResource CardShadow}"/>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Макет -->
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="20"
          RowSpacing="20"
          BackgroundColor="{StaticResource SecondaryBg}">

        <!-- Верхняя панель с современным дизайном -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="4">
            <!-- Логотип с градиентом -->
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border Background="{StaticResource HeaderGradient}"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="IT"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                <Label Text="IndexTF"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Профиль пользователя -->
            <Border Grid.Column="1" Style="{StaticResource ProfileBadge}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTappedProfile"> </TapGestureRecognizer>
                </Border.GestureRecognizers>
                
                <HorizontalStackLayout Spacing="10">
                    <Border Background="{StaticResource HeaderGradient}"
                            WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <Ellipse/>
                        </Border.StrokeShape>
                        <Image Source="person.png" 
                               HeightRequest="18" 
                               WidthRequest="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <Label x:Name="UserNikname" 
                           Text="User Name" 
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Поисковая строка с иконкой -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Label Text="🔍"
                       FontSize="20"
                       VerticalOptions="Center"
                       Opacity="0.5"/>
                <Entry Grid.Column="1"
                       x:Name="SearchEmpty"
                       Placeholder="Search files, content, or indexers..."
                       ReturnType="Search"
                       TextChanged="SearchEntry_TextChanged"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       FontSize="15"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"/>
            </Grid>
        </Border>

        <!-- Список результатов с улучшенными карточками -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
            <CollectionView x:Name="ResultInfo"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Always">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <!-- Empty State -->
                <CollectionView.EmptyView>
                    <Grid Padding="40">
                        <VerticalStackLayout Spacing="16" 
                                            HorizontalOptions="Center" 
                                            VerticalOptions="Center">
                            <Border Background="{StaticResource AccentGlow}"
                                    WidthRequest="80"
                                    HeightRequest="80"
                                    HorizontalOptions="Center"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Label Text="📂"
                                       FontSize="40"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="0.4"/>
                            </Border>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="No results found"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Try adjusting your search terms or explore indexed files"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Opacity="0.7"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>

                <!-- Премиальные карточки результатов -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6" 
                                Padding="18,16"
                                Style="{StaticResource ResultCardStyle}">

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                <!-- Хедер карточки с иконкой типа файла -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Background="{StaticResource AccentGlow}"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            StrokeThickness="0"
                                            VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="📄"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Opacity="0.6"/>
                                    </Border>

                                    <!-- Название файла -->
                                    <Label Grid.Column="1"
                                           Text="{Binding FileName}" 
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" 
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFileNameTapped" 
                                                                CommandParameter="{Binding FilePath}"/>
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!-- Бейдж индексатора -->
                                    <Border Grid.Column="2"
                                            Background="{StaticResource HeaderGradient}"
                                            Padding="10,5"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            Shadow="{StaticResource GlowEffect}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding IndexerName}" 
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               Opacity="0.95"/>
                                    </Border>
                                </Grid>

                                <!-- Превью содержимого -->
                                <Label Grid.Row="1"
                                       Text="{Binding FileText}" 
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" 
                                       MaxLines="2" 
                                       TextColor="{StaticResource TextSecondary}"
                                       LineHeight="1.4"
                                       Margin="44,0,0,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPathTapped" 
                                                            CommandParameter="{Binding FilePath}"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <!-- Разделитель -->
                                <BoxView Grid.Row="2"
                                         HeightRequest="0.5"
                                         BackgroundColor="{StaticResource BorderColor}"
                                         Opacity="0.3"
                                         Margin="44,2,0,2"/>

                                <!-- Метаданные файла -->
                                <Grid Grid.Row="3" 
                                      ColumnDefinitions="*,Auto" 
                                      ColumnSpacing="12"
                                      Margin="44,0,0,0">
                                    <Label Text="{Binding FilePath}" 
                                           FontSize="11"
                                           LineBreakMode="TailTruncation" 
                                           TextColor="{StaticResource TextTertiary}"
                                           Opacity="0.7"
                                           VerticalOptions="Center"
                                           FontFamily="Monospace">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPathTapped" 
                                                                CommandParameter="{Binding FilePath}"/>
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!-- Индикатор действия -->
                                    <Label Grid.Column="1"
                                           Text="→"
                                           FontSize="13"
                                           TextColor="{StaticResource AccentPrimary}"
                                           Opacity="0.4"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Нижние кнопки с современным дизайном -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0">
            <Button Text="📁 Index Files"
                    BackgroundColor="{StaticResource AccentPrimary}"
                    TextColor="White"
                    FontSize="15"/>
            <Button Grid.Column="1"
                    Text="🚪 Exit"
                    BackgroundColor="{StaticResource TextSecondary}"
                    TextColor="White"
                    FontSize="15"
                    Clicked="OnExitClick"/>
        </Grid>

    </Grid>
</ContentPage>