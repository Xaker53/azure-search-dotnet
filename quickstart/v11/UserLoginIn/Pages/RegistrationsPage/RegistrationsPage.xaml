<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UserLoginIn.RegistrationsPage"
             Title="Register"
             NavigationPage.HasNavigationBar="False">


    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#020101" Offset="0.0" />
            <GradientStop Color="#F72585" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    
    <ScrollView>
        <VerticalStackLayout
            Spacing="16"
            Padding="40, 1"
            VerticalOptions="Center"
            >

            <!-- Логотип -->
            <Image Source="house.png"
                   HeightRequest="90"
                   HorizontalOptions="Center" />

            <!-- Заголовок -->
            <Label Text="Create Account"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,-100,0,20"/>

            <!-- Nickname -->
            <Label Text="Nickname"
                   FontSize="14"
                   TextColor="#FFE0E0E0"
                   Margin="4,0,0,0"/>
            <Entry x:Name="NicknameEntry"
                   FontSize="16"
                   TextColor="White"
                   PlaceholderColor="#FFFFFF90"
                   BackgroundColor="Transparent"
                   Placeholder="Enter your nickname"
                   HeightRequest="45"
                   Margin="0,0,0,10"/>
            <BoxView HeightRequest="2" Color="#FFFFFF90"/>

            <!-- Gmail -->
            <Label Text="Email"
                   FontSize="14"
                   TextColor="#FFE0E0E0"
                   Margin="4,10,0,0"/>
            <Entry x:Name="GmailEntry"
                   FontSize="16"
                   TextColor="White"
                   PlaceholderColor="#FFFFFF90"
                   BackgroundColor="Transparent"
                   Placeholder="Enter your email"
                   HeightRequest="45"
                   Margin="0,0,0,10"/>
            <BoxView HeightRequest="2" Color="#FFFFFF90"/>

            <!-- Password -->
            <Label Text="Password"
                   FontSize="14"
                   TextColor="#FFE0E0E0"
                   Margin="4,10,0,0"/>
            <Entry x:Name="PasswordEntry"
                   FontSize="16"
                   TextColor="White"
                   PlaceholderColor="#FFFFFF90"
                   BackgroundColor="Transparent"
                   IsPassword="True"
                   Placeholder="Enter your password"
                   HeightRequest="45"
                   Margin="0,0,0,20"/>
            <BoxView HeightRequest="2" Color="#FFFFFF90"/>

            <!-- Кнопки -->
            <HorizontalStackLayout
                Spacing="15"
                HorizontalOptions="Center">

                <!-- REGISTER -->
                <Button Text="REGISTER"
                        WidthRequest="120"
                        HeightRequest="45"
                        FontAttributes="Bold"
                        BackgroundColor="#3A0CA3"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnRegisterClicked">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsPressed" Value="True">
                            <Setter Property="BackgroundColor" Value="#480CA8"/>
                        </Trigger>
                    </Button.Triggers>
                </Button>

                <!-- BACK -->
                <Button Text="BACK"
                        WidthRequest="120"
                        HeightRequest="45"
                        FontAttributes="Bold"
                        BackgroundColor="White"
                        TextColor="#3A0CA3"
                        CornerRadius="8"
                        Clicked="OnBackClicked">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsPressed" Value="True">
                            <Setter Property="BackgroundColor" Value="#EDEDED"/>
                        </Trigger>
                    </Button.Triggers>
                </Button>

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>